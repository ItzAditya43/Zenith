{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zenith",
  "version": "0.1.0",
  "identifier": "dev.zenith.desktop",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zenith",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/cortex-backend"],
    "resources": [],
    "category": "Productivity",
    "shortDescription": "Self-hosted local AI chat for Ollama",
    "longDescription": "Zenith is a local-first AI chat client that runs against your own Ollama models. No cloud, no accounts."
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/ItzAditya43/Zenith/releases/latest/download/latest.json"
